<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Suiyi.Windows.Program</StartupObject>
    <AssemblyName>Suiyi</AssemblyName>
    <Version>0.1.0-alpha.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Transit · 随译</Product>
    <Description>英俄屏幕翻译 · 早期 Alpha 版本</Description>
    <ApplicationIcon>../../assets/app-icon/app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RestorePackagesPath>../../.local/nuget</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../assets/app-icon/app.ico" Link="Assets/app.ico" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <Content Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tessdata\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="licenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The SDK applies app-relative runtime search only when publishing. Also
       configure the ordinary development apphost so double-clicking it works. -->
  <Target Name="ConfigureDevelopmentRuntimeSearch" AfterTargets="_CreateAppHost"
          Condition="'$(SelfContained)' != 'true' and '$(UseAppHost)' == 'true' and Exists('$(AppHostSourcePath)') and Exists('@(IntermediateAssembly)')">
    <PropertyGroup>
      <_TransitRuntimeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../.local/dotnet'))</_TransitRuntimeRoot>
      <_TransitRuntimeRelativePath>$([MSBuild]::MakeRelative('$(TargetDir)', '$(_TransitRuntimeRoot)'))</_TransitRuntimeRelativePath>
    </PropertyGroup>
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(AppHostIntermediatePath)"
                   AppBinaryName="$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)"
                   DisableCetCompat="$(_DisableCetCompat)"
                   DotNetSearchLocations="AppRelative;Global"
                   AppRelativeDotNet="$(_TransitRuntimeRelativePath)" />
  </Target>
</Project>
